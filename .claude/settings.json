{
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/develop-web-feature/scripts/setup.mjs*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/cache-check.mjs*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/discover.mjs*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/cache-write.mjs*)",
      "Bash(npm run dev*)",
      "Bash(node .claude/skills/impeccable/scripts/critique-storage.mjs*)",
      "Skills(create-pr)",
      "Skills(commit-message)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-commit-guard.sh",
            "statusMessage": "Enforcing /commit-message skill..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/gh-pr-guard.sh",
            "statusMessage": "Enforcing /create-pr skill..."
          }
        ]
      }
    ]
  }
}
