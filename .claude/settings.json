{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx playwright*)",
      "Bash(node .cache/develop-web-feature/*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/setup.mjs*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/cache-check.mjs*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/discover.mjs*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/cache-write.mjs*)",
      "Bash(node .claude/skills/impeccable/scripts/critique-storage.mjs*)",
      "Bash(IMPECCABLE_CRITIQUE_META=*)",
      "Bash(npx vitest*)",
      "Bash(npx impeccable*)",
      "Bash(node .claude/skills/develop-web-feature/scripts/dev-server.mjs*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git push:*)",
      "Bash(node .claude/skills/impeccable/scripts/*)",
      "Bash(CLAUDE_COMMIT_VIA_SKILL=1 git commit:*)",
      "Bash(CLAUDE_PR_VIA_SKILL=1 gh pr create:*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Skill(develop-web-feature)",
      "Skill(develop-web-feature:*)",
      "Skill(commit-message)",
      "Skill(commit-message:*)",
      "Skill(create-pr)",
      "Skill(create-pr:*)",
      "Skill(impeccable)",
      "Skill(impeccable:*)",
      "Skill(update-readme)",
      "Skill(update-readme:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(mkdir -p *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-commit-guard.sh",
            "statusMessage": "Enforcing /commit-message skill..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/gh-pr-guard.sh",
            "statusMessage": "Enforcing /create-pr skill..."
          }
        ]
      }
    ]
  }
}
